diff -ruN a/cli/core.c b/cli/core.c
--- a/cli/core.c	2026-08-02 02:39:02.000000000 +0200
+++ b/cli/core.c	2026-08-19 01:26:38.876492842 +0200
@@ -1081,8 +1081,14 @@
 		state->want_render_ops = msvc_renderer_get();
 #endif
 
-	if (pkgconf_client_getenv(&state->pkg_client, "PKG_CONFIG_FDO_SYSROOT_RULES"))
-		want_client_flags |= PKGCONF_PKG_PKGF_FDO_SYSROOT_RULES;
+	/* Default to FDO sysroot rules (do not prefix --variable with
+	 * SYSROOT). PKG_CONFIG_FDO_SYSROOT_RULES=0 restores 3.x prefixing.
+	 */
+	{
+		const char *fdo = pkgconf_client_getenv(&state->pkg_client, "PKG_CONFIG_FDO_SYSROOT_RULES");
+		if (fdo == NULL || strcmp(fdo, "0") != 0)
+			want_client_flags |= PKGCONF_PKG_PKGF_FDO_SYSROOT_RULES;
+	}
 
 	if (pkgconf_client_getenv(&state->pkg_client, "PKG_CONFIG_PKGCONF1_SYSROOT_RULES"))
 		want_client_flags |= PKGCONF_PKG_PKGF_PKGCONF1_SYSROOT_RULES;
diff -ruN a/man/pkgconf.1 b/man/pkgconf.1
--- a/man/pkgconf.1	2026-08-02 02:39:02.000000000 +0200
+++ b/man/pkgconf.1	2026-08-19 01:26:38.947110390 +0200
@@ -685,7 +685,16 @@
 .It Ev PKG_CONFIG_DONT_RELOCATE_PATHS
 If set, disables the path relocation feature.
 .It Ev PKG_CONFIG_FDO_SYSROOT_RULES
-If set, follow the sysroot prefixing rules that freedesktop.org pkg-config uses.
+If unset or set to any value other than
+.Li 0 ,
+follow the sysroot prefixing rules that freedesktop.org pkg-config uses
+(do not prefix
+.Fl -variable
+results with
+.Ev PKG_CONFIG_SYSROOT_DIR ).
+Set to
+.Li 0
+to restore pkgconf 3.x sysroot prefixing of path-like variables.
 .It Ev PKG_CONFIG_IGNORE_CONFLICTS
 If set, ignore
 .Ic Conflicts
